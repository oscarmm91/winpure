<UserControl x:Class="WinPure.Views.InstallerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,18,0,12">
            <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="SemiBold"
                       Foreground="{StaticResource Brush.TextPrimary}"/>
            <TextBlock Text="{Binding Subtitle}" FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource Brush.TextSecondary}" MaxWidth="640" HorizontalAlignment="Left"/>
        </StackPanel>

        <!-- what winget sees, and a way to ask again -->
        <Border Grid.Row="1" Background="{StaticResource Brush.Card}" CornerRadius="8" Padding="14,10" Margin="0,0,6,12"
                BorderThickness="1" BorderBrush="{StaticResource Brush.CardBorder}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Command="{Binding RefreshCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="{StaticResource Font.Icon}" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="Check again" Margin="7,0,0,0"/>
                    </StackPanel>
                </Button>
                <TextBlock Text="&#xE946;" FontFamily="{StaticResource Font.Icon}" FontSize="13" VerticalAlignment="Center"
                           Foreground="{StaticResource Brush.TextSecondary}"/>
                <TextBlock Text="{Binding Summary}" FontSize="12.5" Margin="10,0,12,0" VerticalAlignment="Center"
                           TextWrapping="Wrap" Foreground="{StaticResource Brush.TextSecondary}"/>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <ItemsControl ItemsSource="{Binding Apps}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource Brush.Card}" CornerRadius="8" Margin="0,0,10,10"
                                Padding="16,12" BorderThickness="1" BorderBrush="{StaticResource Brush.CardBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10"
                                        Background="#28344E" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource Font.Icon}" FontSize="17"
                                               Foreground="#5CA9E8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource Brush.TextPrimary}"/>
                                    <TextBlock Text="{Binding Description}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"
                                               Foreground="{StaticResource Brush.TextSecondary}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding Group}" FontSize="11" Foreground="{StaticResource Brush.TextTertiary}"/>
                                        <TextBlock Text="{Binding StatusText}" FontSize="11" Margin="10,0,0,0" TextWrapping="Wrap"
                                                   Foreground="{StaticResource Brush.GreenText}"/>
                                    </StackPanel>
                                </StackPanel>

                                <Button Grid.Column="2" Style="{StaticResource SubtleButton}" VerticalAlignment="Center"
                                        Visibility="{Binding CanInstall, Converter={StaticResource BoolToVisibility}}"
                                        Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE896;" FontFamily="{StaticResource Font.Icon}" FontSize="12"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="Install" Margin="7,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
