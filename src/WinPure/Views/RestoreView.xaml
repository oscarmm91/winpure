<UserControl x:Class="WinPure.Views.RestoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,18,0,16">
            <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="SemiBold"
                       Foreground="{StaticResource Brush.TextPrimary}"/>
            <TextBlock Text="{Binding Subtitle}" FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource Brush.TextSecondary}" MaxWidth="640" HorizontalAlignment="Left"/>
        </StackPanel>

        <!-- empty state -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="&#xE81C;" FontFamily="{StaticResource Font.Icon}" FontSize="44"
                       Foreground="{StaticResource Brush.TextTertiary}" HorizontalAlignment="Center"/>
            <TextBlock Text="No backups yet" FontSize="15" FontWeight="SemiBold" Margin="0,14,0,0"
                       Foreground="{StaticResource Brush.TextSecondary}" HorizontalAlignment="Center"/>
            <TextBlock Text="A snapshot is created automatically every time you apply changes."
                       FontSize="12.5" Margin="0,6,0,0" Foreground="{StaticResource Brush.TextTertiary}"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <ItemsControl ItemsSource="{Binding Sessions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource Brush.Card}" CornerRadius="8" Margin="0,0,0,10"
                                Padding="18,14" BorderThickness="1" BorderBrush="{StaticResource Brush.CardBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10"
                                        Background="#28344E" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE81C;" FontFamily="{StaticResource Font.Icon}" FontSize="17"
                                               Foreground="#5CA9E8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource Brush.TextPrimary}"/>
                                    <TextBlock Text="{Binding Summary}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"
                                               Foreground="{StaticResource Brush.TextSecondary}"/>
                                    <TextBlock Text="{Binding EntryCount}" FontSize="11" Margin="0,3,0,0"
                                               Foreground="{StaticResource Brush.TextTertiary}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource SubtleButton}" Margin="0,0,8,0"
                                            Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE7A7;" FontFamily="{StaticResource Font.Icon}" FontSize="12"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="Restore" Margin="7,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource DangerButton}"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE74D;" FontFamily="{StaticResource Font.Icon}" FontSize="12"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="Delete" Margin="7,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
