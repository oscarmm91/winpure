<UserControl x:Class="WinPure.Views.FileLinkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:WinPure.Views">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,18,6,12" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="SemiBold"
                       Foreground="{StaticResource Brush.TextPrimary}"/>
            <TextBlock Text="{Binding Subtitle}" FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource Brush.TextSecondary}"/>

            <Border Background="{StaticResource Brush.Card}" CornerRadius="8" Padding="18,16" Margin="0,18,0,0"
                    BorderThickness="1" BorderBrush="{StaticResource Brush.CardBorder}">
                <StackPanel>
                    <TextBlock Text="{l:Tr 'Folder to move'}" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.TextPrimary}"/>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding Source}" IsReadOnly="True" Padding="8,6"
                                 Background="{StaticResource Brush.Background}" Foreground="{StaticResource Brush.TextPrimary}"
                                 BorderBrush="{StaticResource Brush.CardBorder}" BorderThickness="1"/>
                        <Button Grid.Column="1" Style="{StaticResource SubtleButton}" Margin="8,0,0,0"
                                Command="{Binding PickSourceCommand}" Content="{l:Tr 'Browse…'}"/>
                    </Grid>

                    <TextBlock Text="{l:Tr 'Destination drive or folder'}" FontSize="12.5" FontWeight="SemiBold" Margin="0,14,0,0"
                               Foreground="{StaticResource Brush.TextPrimary}"/>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding DestinationParent}" IsReadOnly="True" Padding="8,6"
                                 Background="{StaticResource Brush.Background}" Foreground="{StaticResource Brush.TextPrimary}"
                                 BorderBrush="{StaticResource Brush.CardBorder}" BorderThickness="1"/>
                        <Button Grid.Column="1" Style="{StaticResource SubtleButton}" Margin="8,0,0,0"
                                Command="{Binding PickDestinationCommand}" Content="{l:Tr 'Browse…'}"/>
                    </Grid>

                    <TextBlock Text="{Binding Preview}" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource Brush.TextSecondary}"/>

                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding MoveCommand}" Margin="0,14,0,0"
                            HorizontalAlignment="Left" Content="{l:Tr 'Move and leave a junction'}"/>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding Status}" FontSize="12.5" Margin="2,16,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource Brush.TextSecondary}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
