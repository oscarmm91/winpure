<UserControl x:Class="WinPure.Views.PathView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:WinPure.Views">

    <Grid Margin="0,18,6,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="SemiBold"
                       Foreground="{StaticResource Brush.TextPrimary}"/>
            <TextBlock Text="{Binding Subtitle}" FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource Brush.TextSecondary}" MaxWidth="740" HorizontalAlignment="Left"/>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,4">
                <RadioButton GroupName="scope" Content="{l:Tr 'User PATH'}" IsChecked="{Binding UserScope}"
                             Foreground="{StaticResource Brush.TextPrimary}" VerticalContentAlignment="Center"/>
                <RadioButton GroupName="scope" Content="{l:Tr 'Machine PATH'}" IsChecked="{Binding MachineScope}" Margin="18,0,0,0"
                             Foreground="{StaticResource Brush.TextPrimary}" VerticalContentAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="{Binding Summary}" FontSize="12.5" Margin="0,4,0,10" TextWrapping="Wrap"
                       Foreground="{StaticResource Brush.TextSecondary}"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource Brush.Card}" CornerRadius="8" Margin="0,0,0,12"
                BorderThickness="1" BorderBrush="{StaticResource Brush.CardBorder}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,10">
                <ItemsControl ItemsSource="{Binding Entries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12.5" Margin="8,0,0,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource Brush.TextPrimary}"/>
                                <Border Grid.Column="2" Background="{StaticResource Brush.CardBorder}" CornerRadius="4"
                                        Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding HasIssue, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding IssueText}" FontSize="11"
                                               Foreground="{StaticResource Brush.TextSecondary}"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,14">
            <Button Style="{StaticResource PrimaryButton}" Command="{Binding ApplyCommand}"
                    Content="{l:Tr 'Remove ticked entries'}"/>
            <Button Style="{StaticResource SubtleButton}" Command="{Binding ReloadCommand}" Margin="8,0,0,0"
                    Content="{l:Tr 'Reload'}"/>
        </StackPanel>
    </Grid>
</UserControl>
