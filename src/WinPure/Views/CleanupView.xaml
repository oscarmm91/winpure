<UserControl x:Class="WinPure.Views.CleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:WinPure.Views">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,18,0,14">
            <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="SemiBold"
                       Foreground="{StaticResource Brush.TextPrimary}"/>
            <TextBlock Text="{Binding Subtitle}" FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource Brush.TextSecondary}" MaxWidth="720" HorizontalAlignment="Left"/>
        </StackPanel>

        <!-- total + clean button -->
        <Border Grid.Row="1" Background="{StaticResource Brush.Card}" CornerRadius="8" Padding="16,12"
                Margin="0,0,0,12" BorderThickness="1" BorderBrush="{StaticResource Brush.CardBorder}">
            <Grid>
                <TextBlock Text="{Binding SelectedSizeText}" FontSize="13" VerticalAlignment="Center"
                           Foreground="{StaticResource Brush.TextSecondary}"/>
                <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"
                        Command="{Binding CleanCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" FontFamily="{StaticResource Font.Icon}" FontSize="14"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="{l:Tr 'Clean selected'}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource Brush.Card}" CornerRadius="8" Margin="0,0,0,8"
                                Padding="16,12" BorderThickness="1" BorderBrush="{StaticResource Brush.CardBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          VerticalAlignment="Center" Margin="0,0,12,0"/>

                                <Border Grid.Column="1" Width="38" Height="38" CornerRadius="9"
                                        Background="#28344E" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource Font.Icon}" FontSize="16"
                                               Foreground="#5CA9E8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="2" Margin="14,0,12,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Brush.TextPrimary}"/>
                                        <Border Background="#3A2A1E" CornerRadius="4" Padding="6,1" Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding NeedsConfirm, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{l:Tr 'your files'}" FontSize="10.5"
                                                       Foreground="{StaticResource Brush.Orange}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"
                                               Foreground="{StaticResource Brush.TextSecondary}"/>
                                </StackPanel>

                                <TextBlock Grid.Column="3" Text="{Binding SizeText}" FontSize="12.5" VerticalAlignment="Center"
                                           MinWidth="90" TextAlignment="Right"
                                           Foreground="{StaticResource Brush.TextSecondary}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
