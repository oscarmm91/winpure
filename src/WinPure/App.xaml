<Application x:Class="WinPure.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WinPure.ViewModels"
             xmlns:views="clr-namespace:WinPure.Views"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Colors.xaml"/>
                <ResourceDictionary Source="Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
            <views:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
            <views:EnumEqualsConverter x:Key="EnumEquals"/>

            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views:DashboardView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CategoryPageViewModel}">
                <views:CategoryView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:RestoreViewModel}">
                <views:RestoreView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:RepairViewModel}">
                <views:RepairView/>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
