<Window x:Class="WinPure.Views.WinPureDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" SizeToContent="Height" MinHeight="120"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="ToolWindow"
        ShowInTaskbar="False"
        Background="{StaticResource Brush.Background}" Foreground="{StaticResource Brush.TextPrimary}"
        FontFamily="{StaticResource Font.Base}" TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Grid Margin="26,22,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock x:Name="IconGlyph" FontFamily="{StaticResource Font.Icon}" FontSize="24"
                       VerticalAlignment="Top" Margin="0,1,16,0"/>
            <StackPanel MaxWidth="352">
                <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                           Foreground="{StaticResource Brush.TextPrimary}"/>
                <TextBlock x:Name="MessageText" FontSize="12.5" Margin="0,8,0,0" TextWrapping="Wrap"
                           Foreground="{StaticResource Brush.TextSecondary}" LineHeight="18"/>
            </StackPanel>
        </StackPanel>

        <StackPanel x:Name="Buttons" Grid.Row="1" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,22,0,0"/>
    </Grid>
</Window>
