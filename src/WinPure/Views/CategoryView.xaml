<UserControl x:Class="WinPure.Views.CategoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:WinPure.Models">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- header -->
        <StackPanel Grid.Row="0" Margin="0,18,0,0">
            <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="SemiBold"
                       Foreground="{StaticResource Brush.TextPrimary}"/>
            <TextBlock Text="{Binding Subtitle}" FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource Brush.TextSecondary}" MaxWidth="640" HorizontalAlignment="Left"/>
        </StackPanel>

        <!-- preset selector -->
        <UniformGrid Grid.Row="1" Columns="3" Margin="0,20,0,0">
            <RadioButton Style="{StaticResource PresetButton}" GroupName="Preset" Margin="0,0,8,0"
                         Background="{StaticResource Brush.GreenSoft}" BorderBrush="{StaticResource Brush.Green}"
                         IsChecked="{Binding Main.ActivePreset, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Safe}"
                         Command="{Binding Main.SelectPresetCommand}"
                         CommandParameter="{x:Static models:PresetLevel.Safe}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xEA18;" FontFamily="{StaticResource Font.Icon}" FontSize="18"
                               Foreground="{StaticResource Brush.GreenText}" VerticalAlignment="Center"/>
                    <StackPanel Margin="12,0,0,0">
                        <TextBlock Text="Safe" FontSize="14.5" FontWeight="SemiBold"/>
                        <TextBlock Text="Recommended" FontSize="11.5" Foreground="{StaticResource Brush.TextSecondary}"/>
                    </StackPanel>
                </StackPanel>
            </RadioButton>
            <RadioButton Style="{StaticResource PresetButton}" GroupName="Preset" Margin="4,0,4,0"
                         Background="{StaticResource Brush.AccentSoft}" BorderBrush="{StaticResource Brush.Accent}"
                         IsChecked="{Binding Main.ActivePreset, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Balanced}"
                         Command="{Binding Main.SelectPresetCommand}"
                         CommandParameter="{x:Static models:PresetLevel.Balanced}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xF080;" FontFamily="{StaticResource Font.Icon}" FontSize="18"
                               Foreground="#5CA9E8" VerticalAlignment="Center"/>
                    <StackPanel Margin="12,0,0,0">
                        <TextBlock Text="Balanced" FontSize="14.5" FontWeight="SemiBold"/>
                        <TextBlock Text="Default" FontSize="11.5" Foreground="{StaticResource Brush.TextSecondary}"/>
                    </StackPanel>
                </StackPanel>
            </RadioButton>
            <RadioButton Style="{StaticResource PresetButton}" GroupName="Preset" Margin="8,0,0,0"
                         Background="{StaticResource Brush.OrangeSoft}" BorderBrush="{StaticResource Brush.Orange}"
                         IsChecked="{Binding Main.ActivePreset, Mode=OneWay, Converter={StaticResource EnumEquals}, ConverterParameter=Aggressive}"
                         Command="{Binding Main.SelectPresetCommand}"
                         CommandParameter="{x:Static models:PresetLevel.Aggressive}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE945;" FontFamily="{StaticResource Font.Icon}" FontSize="18"
                               Foreground="{StaticResource Brush.Orange}" VerticalAlignment="Center"/>
                    <StackPanel Margin="12,0,0,0">
                        <TextBlock Text="Aggressive" FontSize="14.5" FontWeight="SemiBold"/>
                        <TextBlock Text="Maximum Privacy" FontSize="11.5" Foreground="{StaticResource Brush.TextSecondary}"/>
                    </StackPanel>
                </StackPanel>
            </RadioButton>
        </UniformGrid>

        <!-- section label -->
        <DockPanel Grid.Row="2" Margin="0,22,0,10">
            <TextBlock Text="{Binding Title}" DockPanel.Dock="Left" FontSize="12.5"
                       Foreground="{StaticResource Brush.TextSecondary}"/>
            <Separator Margin="14,0,0,0" Background="{StaticResource Brush.Divider}"/>
        </DockPanel>

        <!-- tweak cards -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <ItemsControl ItemsSource="{Binding Tweaks}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource Brush.Card}" CornerRadius="8" Margin="0,0,10,10"
                                Padding="16,14" BorderThickness="1" BorderBrush="{StaticResource Brush.CardBorder}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Brush.CardHover}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- icon -->
                                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="10"
                                        VerticalAlignment="Top" Margin="0,2,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#28344E"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOptimized}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource Brush.GreenSoft}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource Font.Icon}" FontSize="17"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#5CA9E8"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOptimized}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource Brush.GreenText}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>

                                <!-- text -->
                                <StackPanel Grid.Column="1" Margin="14,0,12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Brush.TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="&#xE946;" FontFamily="{StaticResource Font.Icon}" FontSize="12"
                                                   Margin="8,1,0,0" Foreground="{StaticResource Brush.TextTertiary}"
                                                   VerticalAlignment="Center" ToolTipService.InitialShowDelay="200">
                                            <TextBlock.ToolTip>
                                                <TextBlock Text="{Binding Help}" TextWrapping="Wrap"/>
                                            </TextBlock.ToolTip>
                                        </TextBlock>
                                        <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource Font.Icon}" FontSize="12"
                                                   Margin="6,1,0,0" Foreground="{StaticResource Brush.Orange}"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding FullyReversible, Converter={StaticResource InverseBoolToVisibility}}">
                                            <TextBlock.ToolTip>
                                                <TextBlock Text="Undo requires reinstalling from the Microsoft Store." TextWrapping="Wrap"/>
                                            </TextBlock.ToolTip>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}" FontSize="12" Margin="0,4,0,0"
                                               TextWrapping="Wrap" Foreground="{StaticResource Brush.TextSecondary}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                        <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{StaticResource Brush.TextTertiary}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOptimized}" Value="True">
                                                            <Setter Property="Fill" Value="{StaticResource Brush.GreenText}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding StatusText}" FontSize="11" Margin="6,0,0,0"
                                                   Foreground="{StaticResource Brush.TextTertiary}"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- toggle -->
                                <ToggleButton Grid.Column="2" Style="{StaticResource ToggleSwitch}"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              IsEnabled="{Binding DataContext.Main.IsIdle, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
