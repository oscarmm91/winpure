<UserControl x:Class="WinPure.Views.DnsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:WinPure.Views">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,18,0,12">
            <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="SemiBold"
                       Foreground="{StaticResource Brush.TextPrimary}"/>
            <TextBlock Text="{Binding Subtitle}" FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource Brush.TextSecondary}" MaxWidth="720" HorizontalAlignment="Left"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource Brush.Card}" CornerRadius="8" Padding="14,10" Margin="0,0,6,12"
                BorderThickness="1" BorderBrush="{StaticResource Brush.CardBorder}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE968;" FontFamily="{StaticResource Font.Icon}" FontSize="14"
                           Foreground="#5CA9E8" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Summary}" Margin="10,0,0,0" FontSize="12.5" VerticalAlignment="Center"
                           TextWrapping="Wrap" Foreground="{StaticResource Brush.TextSecondary}"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <ItemsControl ItemsSource="{Binding Presets}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource Brush.Card}" CornerRadius="8" Margin="0,0,0,8"
                                Padding="16,12" BorderThickness="1" BorderBrush="{StaticResource Brush.CardBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="9"
                                        Background="#28344E" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource Font.Icon}" FontSize="16"
                                               Foreground="#5CA9E8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource Brush.TextPrimary}"/>
                                    <TextBlock Text="{Binding Description}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"
                                               Foreground="{StaticResource Brush.TextSecondary}"/>
                                </StackPanel>

                                <Button Grid.Column="2" Style="{StaticResource SubtleButton}" VerticalAlignment="Center"
                                        Command="{Binding DataContext.ApplyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE768;" FontFamily="{StaticResource Font.Icon}" FontSize="12"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Text="{l:Tr 'Use this'}" Margin="7,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
