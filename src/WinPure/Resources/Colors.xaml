<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- PRD §8.1 palette -->
    <Color x:Key="Color.Window">#0F0F0F</Color>
    <Color x:Key="Color.Background">#1A1A1A</Color>
    <Color x:Key="Color.Card">#212121</Color>
    <Color x:Key="Color.CardHover">#2A2A2A</Color>

    <SolidColorBrush x:Key="Brush.Window" Color="{StaticResource Color.Window}"/>
    <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Background}"/>
    <SolidColorBrush x:Key="Brush.Card" Color="{StaticResource Color.Card}"/>
    <SolidColorBrush x:Key="Brush.CardHover" Color="{StaticResource Color.CardHover}"/>
    <SolidColorBrush x:Key="Brush.CardBorder" Color="#2E2E2E"/>
    <SolidColorBrush x:Key="Brush.Divider" Color="#2E2E2E"/>

    <SolidColorBrush x:Key="Brush.Accent" Color="#0078D4"/>
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#2089DC"/>
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#1A2C44"/>
    <SolidColorBrush x:Key="Brush.Green" Color="#107C10"/>
    <SolidColorBrush x:Key="Brush.GreenSoft" Color="#16301B"/>
    <SolidColorBrush x:Key="Brush.GreenText" Color="#6CCB5F"/>
    <SolidColorBrush x:Key="Brush.Orange" Color="#F7630C"/>
    <SolidColorBrush x:Key="Brush.OrangeSoft" Color="#33231A"/>
    <SolidColorBrush x:Key="Brush.Danger" Color="#D13438"/>

    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#9D9D9D"/>
    <SolidColorBrush x:Key="Brush.TextTertiary" Color="#6E6E6E"/>

    <!-- sidebar: dark navy wash reminiscent of Mica over a blue desktop -->
    <LinearGradientBrush x:Key="Brush.Sidebar" StartPoint="0,0" EndPoint="0.3,1">
        <GradientStop Color="#1C2742" Offset="0"/>
        <GradientStop Color="#151B2C" Offset="0.45"/>
        <GradientStop Color="#101420" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.SidebarSelected" Color="#2A3A5C"/>
    <SolidColorBrush x:Key="Brush.SidebarHover" Color="#222C44"/>

    <!-- toggle switch -->
    <SolidColorBrush x:Key="Brush.ToggleOff" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="Brush.ToggleThumb" Color="#FFFFFF"/>

    <FontFamily x:Key="Font.Base">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Icon">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

</ResourceDictionary>
