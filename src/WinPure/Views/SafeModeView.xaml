<UserControl x:Class="WinPure.Views.SafeModeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:WinPure.Views">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,18,6,12" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="SemiBold"
                       Foreground="{StaticResource Brush.TextPrimary}"/>
            <TextBlock Text="{Binding Subtitle}" FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource Brush.TextSecondary}"/>

            <Border Background="{StaticResource Brush.Card}" CornerRadius="8" Padding="18,14" Margin="0,18,0,0"
                    BorderThickness="1" BorderBrush="{StaticResource Brush.CardBorder}">
                <StackPanel>
                    <TextBlock Text="{Binding StateText}" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.TextPrimary}"/>
                    <TextBlock Text="{l:Tr 'Safe Mode starts Windows with only the essential drivers and services — useful for troubleshooting. To get back to a normal Windows, come back here and choose Restore normal boot, then restart. This page also works while you are in Safe Mode.'}"
                               FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource Brush.TextSecondary}"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding EnterMinimalCommand}"
                        Content="{l:Tr 'Boot into Safe Mode'}"/>
                <Button Style="{StaticResource SubtleButton}" Command="{Binding EnterNetworkCommand}" Margin="8,0,0,0"
                        Content="{l:Tr 'Safe Mode with Networking'}"/>
            </StackPanel>
            <Button Style="{StaticResource SubtleButton}" Command="{Binding RestoreNormalCommand}"
                    HorizontalAlignment="Left" Margin="0,10,0,0"
                    Content="{l:Tr 'Restore normal boot'}"/>

            <TextBlock Text="{Binding Status}" FontSize="12.5" Margin="2,16,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource Brush.TextSecondary}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
