<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Dev tool, not part of WinPure and not in WinPure.sln: renders the app's pages to PNG without ever
    showing a window. Usage: dotnet run -\-project tools\PageRender -\- <output folder>
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WinPure\WinPure.csproj" />
  </ItemGroup>

</Project>
