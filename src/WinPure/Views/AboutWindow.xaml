<Window x:Class="WinPure.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About WinPure" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource Brush.Background}"
        Foreground="{StaticResource Brush.TextPrimary}"
        FontFamily="{StaticResource Font.Base}"
        WindowStyle="ToolWindow">

    <StackPanel Margin="28,24,28,28">
        <!-- logo -->
        <Grid HorizontalAlignment="Center">
            <TextBlock Text="&#xEA18;" FontFamily="{StaticResource Font.Icon}" FontSize="52"
                       Foreground="{StaticResource Brush.Accent}"/>
            <TextBlock Text="&#xE735;" FontFamily="{StaticResource Font.Icon}" FontSize="16"
                       Foreground="White" Margin="18,16,0,0"/>
        </Grid>
        <TextBlock Text="WinPure" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
        <TextBlock x:Name="VersionText" Text="v1.0.0" FontSize="12" HorizontalAlignment="Center"
                   Foreground="{StaticResource Brush.TextSecondary}"/>

        <Separator Background="{StaticResource Brush.Divider}" Margin="0,18,0,18"/>

        <!-- author -->
        <TextBlock HorizontalAlignment="Center" FontSize="14">
            <Run Text="Made with"/><Run Text=" ❤ " Foreground="#F1707A"/><Run Text="by"/>
            <Run Text="Oscar Medina" FontWeight="SemiBold"/>
        </TextBlock>
        <TextBlock Text="@oscaremeh" FontSize="12.5" HorizontalAlignment="Center" Margin="0,2,0,0"
                   Foreground="{StaticResource Brush.TextSecondary}"/>
        <TextBlock Text="Free for everyone, forever." FontSize="12.5" FontStyle="Italic"
                   HorizontalAlignment="Center" Margin="0,10,0,0"
                   Foreground="{StaticResource Brush.GreenText}"/>

        <!-- socials -->
        <UniformGrid Columns="3" Margin="0,20,0,0">
            <Button Style="{StaticResource SubtleButton}" Margin="0,0,6,0"
                    Click="OpenLink" Tag="https://www.instagram.com/oscar.emeh/">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE722;" FontFamily="{StaticResource Font.Icon}" FontSize="14"
                               Foreground="#E1306C" VerticalAlignment="Center"/>
                    <TextBlock Text="Instagram" Margin="7,0,0,0"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource SubtleButton}" Margin="3,0,3,0"
                    Click="OpenLink" Tag="https://www.tiktok.com/@oscar.emeh">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource Font.Icon}" FontSize="14"
                               Foreground="#69C9D0" VerticalAlignment="Center"/>
                    <TextBlock Text="TikTok" Margin="7,0,0,0"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource SubtleButton}" Margin="6,0,0,0"
                    Click="OpenLink" Tag="https://www.youtube.com/@oscar_emeh">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE768;" FontFamily="{StaticResource Font.Icon}" FontSize="14"
                               Foreground="#FF0000" VerticalAlignment="Center"/>
                    <TextBlock Text="YouTube" Margin="7,0,0,0"/>
                </StackPanel>
            </Button>
        </UniformGrid>

        <Separator Background="{StaticResource Brush.Divider}" Margin="0,18,0,14"/>

        <TextBlock FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                   Foreground="{StaticResource Brush.TextTertiary}"
                   Text="Open source under the MIT license. Tweak research builds on Chris Titus WinUtil, Win11Debloat, Sophia Script and CrapFixer."/>
    </StackPanel>
</Window>
