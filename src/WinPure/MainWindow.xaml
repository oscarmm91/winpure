<Window x:Class="WinPure.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:WinPure.Views"
        xmlns:vm="clr-namespace:WinPure.ViewModels"
        Title="{l:Tr 'WinPure — Windows 11 Optimizer'}"
        Width="1280" Height="860" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Window}"
        Foreground="{StaticResource Brush.TextPrimary}"
        FontFamily="{StaticResource Font.Base}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" CornerRadius="8" GlassFrameThickness="-1"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== sidebar ==================== -->
        <Border Grid.Column="0" Background="{StaticResource Brush.Sidebar}">
            <DockPanel>
                <!-- logo -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,22,16,20">
                    <Grid>
                        <TextBlock Text="&#xEA18;" FontFamily="{StaticResource Font.Icon}" FontSize="34"
                                   Foreground="{StaticResource Brush.Accent}"/>
                        <TextBlock Text="&#xE735;" FontFamily="{StaticResource Font.Icon}" FontSize="11"
                                   Foreground="White" Margin="11,10,0,0"/>
                    </Grid>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="WinPure" FontSize="19" FontWeight="SemiBold"/>
                        <TextBlock Text="{l:Tr 'Windows 11 Optimizer'}" FontSize="11"
                                   Foreground="{StaticResource Brush.TextSecondary}"/>
                    </StackPanel>
                </StackPanel>

                <!-- search across every tweak -->
                <Grid DockPanel.Dock="Top" Margin="16,0,16,10">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="30,7,8,7" FontSize="12.5" BorderThickness="1"
                             Background="#1B2233" Foreground="{StaticResource Brush.TextPrimary}"
                             BorderBrush="{StaticResource Brush.Divider}" CaretBrush="{StaticResource Brush.TextPrimary}"/>
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource Font.Icon}" FontSize="12" Margin="11,0,0,0"
                               VerticalAlignment="Center" IsHitTestVisible="False"
                               Foreground="{StaticResource Brush.TextTertiary}"/>
                    <TextBlock Text="{l:Tr 'Search tweaks'}" FontSize="12.5" Margin="31,0,0,0" VerticalAlignment="Center"
                               IsHitTestVisible="False" Foreground="{StaticResource Brush.TextTertiary}"
                               Visibility="{Binding IsSearching, Converter={StaticResource InverseBoolToVisibility}}"/>
                </Grid>

                <!-- footer: OS info -->
                <StackPanel DockPanel.Dock="Bottom" Margin="16,8,16,16">
                    <Separator Background="{StaticResource Brush.Divider}" Margin="0,0,0,10"/>
                    <Border Background="#1B2233" CornerRadius="8" Padding="12,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE770;" FontFamily="{StaticResource Font.Icon}" FontSize="18"
                                       Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding OsInfo}"
                                       Margin="10,0,0,0" FontSize="11.5" Foreground="{StaticResource Brush.TextSecondary}"
                                       LineHeight="16"/>
                        </StackPanel>
                    </Border>
                    <Button Click="AboutClick" Cursor="Hand" Margin="0,8,0,0" HorizontalAlignment="Stretch">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Padding="12,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xEB51;" FontFamily="{StaticResource Font.Icon}" FontSize="13"
                                                   Foreground="#F1707A" VerticalAlignment="Center"/>
                                        <TextBlock Text="{l:Tr 'About — by Oscar M'}" FontSize="12" Margin="9,0,0,0"
                                                   Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.SidebarHover}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <TextBlock Text="{Binding AppVersion}" HorizontalAlignment="Center" Margin="0,4,0,0"
                               FontSize="10.5" Foreground="{StaticResource Brush.TextTertiary}"/>
                </StackPanel>

                <!-- nav: Home pinned, then collapsible sections, all inside a scroller so nothing is cut off -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,4,0,0">
                    <StackPanel>
                        <!-- Home -->
                        <RadioButton Style="{StaticResource NavButton}" GroupName="Nav" DataContext="{Binding HomeItem}"
                                     IsChecked="{Binding IsCurrent, Mode=TwoWay}"/>

                        <!-- sections -->
                        <ItemsControl ItemsSource="{Binding NavGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,6,0,0">
                                        <!-- section header: click to expand/collapse -->
                                        <Button Command="{Binding ToggleCommand}" Cursor="Hand" HorizontalAlignment="Stretch">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bg" Background="Transparent" Padding="20,7,14,5">
                                                        <Grid>
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Header}" FontSize="10.5" FontWeight="SemiBold"
                                                                           Foreground="{StaticResource Brush.TextTertiary}"/>
                                                                <!-- pending badge, so a collapsed section still shows it has changes -->
                                                                <Border Background="{StaticResource Brush.Accent}" CornerRadius="8" Margin="8,0,0,0"
                                                                        Padding="6,0" MinWidth="16" Height="16"
                                                                        Visibility="{Binding HasPending, Converter={StaticResource BoolToVisibility}}">
                                                                    <TextBlock Text="{Binding PendingCount}" FontSize="10" Foreground="White"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock x:Name="Chev" Text="&#xE70D;" FontFamily="{StaticResource Font.Icon}" FontSize="9"
                                                                       Foreground="{StaticResource Brush.TextTertiary}"
                                                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                                            <Setter TargetName="Chev" Property="Text" Value="&#xE70E;"/>
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Brush.SidebarHover}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <!-- section items -->
                                        <ItemsControl ItemsSource="{Binding Items}"
                                                      Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <RadioButton Style="{StaticResource NavButton}" GroupName="Nav"
                                                                 IsChecked="{Binding IsCurrent, Mode=TwoWay}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ==================== content ==================== -->
        <Grid Grid.Column="1" Background="{StaticResource Brush.Background}">
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- caption row -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="MinimizeClick"/>
                <Button Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="MaximizeClick"/>
                <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="CloseClick"/>
            </StackPanel>

            <!-- undo banner: a one-click revert of the batch just applied, right where the user is looking -->
            <Border Grid.Row="1" Margin="36,6,36,0" Padding="16,10" CornerRadius="8"
                    Background="{StaticResource Brush.GreenSoft}" BorderThickness="1" BorderBrush="{StaticResource Brush.Green}"
                    Visibility="{Binding ShowUndoBanner, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#xE930;" FontFamily="{StaticResource Font.Icon}" FontSize="15"
                               Foreground="{StaticResource Brush.GreenText}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding UndoBannerText}" Margin="10,0,12,0" FontSize="12.5"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource Brush.TextPrimary}"/>
                    <Button Grid.Column="2" Style="{StaticResource SubtleButton}" Command="{Binding UndoLastCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7A7;" FontFamily="{StaticResource Font.Icon}" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="{l:Tr 'Undo'}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="3" Style="{StaticResource SubtleButton}" Margin="8,0,0,0"
                            Command="{Binding DismissUndoCommand}" ToolTip="{l:Tr 'Dismiss'}">
                        <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource Font.Icon}" FontSize="11" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>

            <!-- active page -->
            <ContentControl Grid.Row="2" Content="{Binding CurrentPage}" Margin="36,4,36,0"/>

            <!-- apply bar -->
            <Border Grid.Row="3" BorderBrush="{StaticResource Brush.Divider}" BorderThickness="0,1,0,0"
                    Padding="36,16" Background="{StaticResource Brush.Background}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- Left hint fills the star column and ellipsizes instead of sliding under the right group.
                         Two columns keep the two groups apart; before, they shared one cell and overlapped. -->
                    <DockPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock DockPanel.Dock="Left" Text="&#xE930;" FontFamily="{StaticResource Font.Icon}" FontSize="15"
                                   Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ApplyHint}" Margin="10,0,0,0" FontSize="12.5"
                                   Foreground="{StaticResource Brush.TextSecondary}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding ApplyHint}"/>
                    </DockPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <CheckBox IsChecked="{Binding ApplyToFutureUsers}" VerticalAlignment="Center" Margin="0,0,18,0"
                                  Visibility="{Binding FutureUsersApplies, Converter={StaticResource BoolToVisibility}}"
                                  Foreground="{StaticResource Brush.TextSecondary}"
                                  Content="{l:Tr 'Apply to new user accounts too'}"
                                  ToolTip="{l:Tr 'Writes these per-user settings into the Default profile, so accounts created later start with them. Undone from Restore.'}"/>
                        <TextBlock Text="{Binding StatusText}" FontSize="12" Margin="0,0,18,0"
                                   Foreground="{StaticResource Brush.TextTertiary}" VerticalAlignment="Center"
                                   MaxWidth="420" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}"/>
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding ApplyCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEA18;" FontFamily="{StaticResource Font.Icon}" FontSize="14"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{l:Tr 'Apply Changes'}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- busy veil -->
            <Border Grid.Row="2" Grid.RowSpan="2" Background="#990F0F0F"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="240" Height="4" Foreground="{StaticResource Brush.Accent}"
                                 Background="#2E2E2E" BorderThickness="0"/>
                    <TextBlock Text="{Binding StatusText}" Margin="0,14,0,0" HorizontalAlignment="Center"
                               Foreground="{StaticResource Brush.TextPrimary}" FontSize="13"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
