<UserControl x:Class="WinPure.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:WinPure.Views"
             xmlns:vm="clr-namespace:WinPure.ViewModels">

    <UserControl.Resources>
        <!-- A pill that filters the list; the active one gets the accent look via its bound Tag. -->
        <Style x:Key="FilterChip" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{StaticResource Brush.Card}"/>
            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush.CardBorder}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="15" Padding="15,7"
                                TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
                </Trigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush.AccentSoft}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}"/>
                    <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,18,0,10">
            <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="SemiBold"
                       Foreground="{StaticResource Brush.TextPrimary}"/>
            <TextBlock Text="{Binding Subtitle}" FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource Brush.TextSecondary}" MaxWidth="700" HorizontalAlignment="Left"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource Brush.Card}" CornerRadius="8" Padding="14,10"
                Margin="0,0,0,12" BorderThickness="1" BorderBrush="{StaticResource Brush.CardBorder}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE946;" FontFamily="{StaticResource Font.Icon}" FontSize="14"
                           Foreground="#5CA9E8" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Summary}" Margin="10,0,0,0" FontSize="12.5" VerticalAlignment="Center"
                           Foreground="{StaticResource Brush.TextSecondary}"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Style="{StaticResource FilterChip}" Content="{Binding AllChipText}"
                    Command="{Binding SetFilterCommand}" CommandParameter="{x:Static vm:StartupFilter.All}"
                    Tag="{Binding IsFilterAll}"/>
            <Button Style="{StaticResource FilterChip}" Content="{Binding EnabledChipText}"
                    Command="{Binding SetFilterCommand}" CommandParameter="{x:Static vm:StartupFilter.Enabled}"
                    Tag="{Binding IsFilterEnabled}"/>
            <Button Style="{StaticResource FilterChip}" Content="{Binding DisabledChipText}"
                    Command="{Binding SetFilterCommand}" CommandParameter="{x:Static vm:StartupFilter.Disabled}"
                    Tag="{Binding IsFilterDisabled}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource Brush.Card}" CornerRadius="8" Margin="0,0,0,8"
                                Padding="16,12" BorderThickness="1" BorderBrush="{StaticResource Brush.CardBorder}"
                                Visibility="{Binding IsVisibleUnderFilter, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="9"
                                        Background="#28344E" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Font.Icon}" FontSize="15"
                                               Foreground="#5CA9E8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="13,0,12,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Brush.TextPrimary}"/>
                                        <Border Background="#3A2A1E" CornerRadius="4" Padding="6,1" Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding IsOrphan, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{l:Tr 'file missing'}" FontSize="10.5"
                                                       Foreground="{StaticResource Brush.Orange}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Publisher}" FontSize="11.5" Margin="0,2,0,0"
                                               Foreground="{StaticResource Brush.TextSecondary}"/>
                                    <TextBlock Text="{Binding Detail}" FontSize="10.5" Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis" MaxWidth="520" HorizontalAlignment="Left"
                                               Foreground="{StaticResource Brush.TextSecondary}" Opacity="0.72"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding SourceLabel}" FontSize="11" HorizontalAlignment="Right"
                                               Foreground="{StaticResource Brush.TextSecondary}"/>
                                    <TextBlock Text="{Binding Scope}" FontSize="10.5" HorizontalAlignment="Right"
                                               Margin="0,2,0,0" Opacity="0.72"
                                               Foreground="{StaticResource Brush.TextSecondary}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StateText}" FontSize="11.5" Width="72"
                                               VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,10,0"
                                               Foreground="{StaticResource Brush.TextSecondary}"/>
                                    <ToggleButton Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
