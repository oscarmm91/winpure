<UserControl x:Class="WinPure.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:WinPure.Views"
             xmlns:models="clr-namespace:WinPure.Models">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,18,6,12">
            <TextBlock Text="{l:Tr 'Dashboard'}" FontSize="28" FontWeight="SemiBold"
                       Foreground="{StaticResource Brush.TextPrimary}"/>
            <TextBlock Text="{l:Tr 'Clean, optimize and take control of Windows 11 — every change is backed up and reversible.'}"
                       FontSize="13" Margin="0,6,0,0" Foreground="{StaticResource Brush.TextSecondary}"/>

            <!-- stats -->
            <UniformGrid Columns="4" Margin="0,24,0,0">
                <Border Background="{StaticResource Brush.Card}" CornerRadius="8" Padding="18,16" Margin="0,0,10,0"
                        BorderThickness="1" BorderBrush="{StaticResource Brush.CardBorder}">
                    <StackPanel>
                        <TextBlock Text="&#xE9D2;" FontFamily="{StaticResource Font.Icon}" FontSize="18" Foreground="#5CA9E8"/>
                        <TextBlock Text="{Binding TotalCount}" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,0"
                                   Foreground="{StaticResource Brush.TextPrimary}"/>
                        <TextBlock Text="{l:Tr 'Available tweaks'}" FontSize="12" Foreground="{StaticResource Brush.TextSecondary}"/>
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource Brush.Card}" CornerRadius="8" Padding="18,16" Margin="0,0,10,0"
                        BorderThickness="1" BorderBrush="{StaticResource Brush.CardBorder}">
                    <StackPanel>
                        <TextBlock Text="&#xE930;" FontFamily="{StaticResource Font.Icon}" FontSize="18"
                                   Foreground="{StaticResource Brush.GreenText}"/>
                        <TextBlock Text="{Binding OptimizedCount}" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,0"
                                   Foreground="{StaticResource Brush.GreenText}"/>
                        <TextBlock Text="{l:Tr 'Already optimized'}" FontSize="12" Foreground="{StaticResource Brush.TextSecondary}"/>
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource Brush.Card}" CornerRadius="8" Padding="18,16" Margin="0,0,10,0"
                        BorderThickness="1" BorderBrush="{StaticResource Brush.CardBorder}">
                    <StackPanel>
                        <TextBlock Text="&#xEA6A;" FontFamily="{StaticResource Font.Icon}" FontSize="18"
                                   Foreground="{StaticResource Brush.Orange}"/>
                        <TextBlock Text="{Binding PendingCount}" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,0"
                                   Foreground="{StaticResource Brush.TextPrimary}"/>
                        <TextBlock Text="{l:Tr 'Pending'}" FontSize="12" Foreground="{StaticResource Brush.TextSecondary}"/>
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource Brush.Card}" CornerRadius="8" Padding="18,16"
                        BorderThickness="1" BorderBrush="{StaticResource Brush.CardBorder}">
                    <StackPanel>
                        <TextBlock Text="&#xE81C;" FontFamily="{StaticResource Font.Icon}" FontSize="18"
                                   Foreground="{StaticResource Brush.TextSecondary}"/>
                        <TextBlock Text="{Binding BackupCount}" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,0"
                                   Foreground="{StaticResource Brush.TextPrimary}"/>
                        <TextBlock Text="{l:Tr 'Backups'}" FontSize="12" Foreground="{StaticResource Brush.TextSecondary}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- presets -->
            <DockPanel Margin="0,28,0,10">
                <TextBlock Text="{l:Tr 'Quick presets'}" DockPanel.Dock="Left" FontSize="12.5"
                           Foreground="{StaticResource Brush.TextSecondary}"/>
                <Separator Margin="14,0,0,0" Background="{StaticResource Brush.Divider}"/>
            </DockPanel>

            <UniformGrid Columns="3">
                <Border Background="{StaticResource Brush.GreenSoft}" CornerRadius="8" Padding="18,16" Margin="0,0,10,0"
                        BorderThickness="1" BorderBrush="{StaticResource Brush.Green}">
                    <StackPanel>
                        <TextBlock Text="{l:Tr 'Safe'}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextPrimary}"/>
                        <TextBlock Text="{l:Tr 'Basic telemetry off, no ads in Start, cleaner context menu. Fully reversible, zero risk.'}"
                                   FontSize="12" Margin="0,6,0,12" TextWrapping="Wrap"
                                   Foreground="{StaticResource Brush.TextSecondary}" MinHeight="48"/>
                        <Button Style="{StaticResource SubtleButton}" Content="{l:Tr 'Select Safe preset'}"
                                Command="{Binding Main.SelectPresetCommand}"
                                CommandParameter="{x:Static models:PresetLevel.Safe}" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource Brush.AccentSoft}" CornerRadius="8" Padding="18,16" Margin="0,0,10,0"
                        BorderThickness="1" BorderBrush="{StaticResource Brush.Accent}">
                    <StackPanel>
                        <TextBlock Text="{l:Tr 'Balanced'}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextPrimary}"/>
                        <TextBlock Text="{l:Tr 'Safe + optional services off, third-party bloatware removed, faster shutdown.'}"
                                   FontSize="12" Margin="0,6,0,12" TextWrapping="Wrap"
                                   Foreground="{StaticResource Brush.TextSecondary}" MinHeight="48"/>
                        <Button Style="{StaticResource SubtleButton}" Content="{l:Tr 'Select Balanced preset'}"
                                Command="{Binding Main.SelectPresetCommand}"
                                CommandParameter="{x:Static models:PresetLevel.Balanced}" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
                <Border Background="{StaticResource Brush.OrangeSoft}" CornerRadius="8" Padding="18,16"
                        BorderThickness="1" BorderBrush="{StaticResource Brush.Orange}">
                    <StackPanel>
                        <TextBlock Text="{l:Tr 'Aggressive'}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextPrimary}"/>
                        <TextBlock Text="{l:Tr 'Balanced + OneDrive removal, Copilot/AI off, Xbox services cleaned, DiagTrack disabled.'}"
                                   FontSize="12" Margin="0,6,0,12" TextWrapping="Wrap"
                                   Foreground="{StaticResource Brush.TextSecondary}" MinHeight="48"/>
                        <Button Style="{StaticResource SubtleButton}" Content="{l:Tr 'Select Aggressive preset'}"
                                Command="{Binding Main.SelectPresetCommand}"
                                CommandParameter="{x:Static models:PresetLevel.Aggressive}" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <TextBlock Margin="0,18,0,0" FontSize="12" Foreground="{StaticResource Brush.TextTertiary}" TextWrapping="Wrap"
                       Text="{l:Tr 'Selecting a preset only marks the toggles — nothing changes until you click Apply Changes. A registry snapshot is saved automatically before every apply; use the Restore page to roll back.'}"/>

            <Button Style="{StaticResource SubtleButton}" Margin="0,16,0,0" HorizontalAlignment="Left"
                    Command="{Binding Main.RescanCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72C;" FontFamily="{StaticResource Font.Icon}" FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock Text="{l:Tr 'Rescan system'}" Margin="8,0,0,0"/>
                </StackPanel>
            </Button>

            <!-- configuration files -->
            <DockPanel Margin="0,28,0,10">
                <TextBlock Text="{l:Tr 'Configuration'}" DockPanel.Dock="Left" FontSize="12.5"
                           Foreground="{StaticResource Brush.TextSecondary}"/>
                <Separator Margin="14,0,0,0" Background="{StaticResource Brush.Divider}"/>
            </DockPanel>
            <TextBlock FontSize="12" Foreground="{StaticResource Brush.TextTertiary}" TextWrapping="Wrap"
                       Text="{l:Tr 'Save which tweaks are switched on, then tick the same ones on another PC. Importing only ticks boxes and never unticks any — nothing changes until you click Apply Changes.'}"/>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Style="{StaticResource SubtleButton}" Command="{Binding Main.ExportConfigCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEDE1;" FontFamily="{StaticResource Font.Icon}" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Text="{l:Tr 'Export configuration'}" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SubtleButton}" Margin="10,0,0,0" Command="{Binding Main.ImportConfigCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B5;" FontFamily="{StaticResource Font.Icon}" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Text="{l:Tr 'Import configuration'}" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
